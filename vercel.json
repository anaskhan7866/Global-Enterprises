{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://api.whatsapp.com; frame-src 'self' https://www.google.com https://maps.google.com; frame-ancestors 'self';" }
      ]
    }
  ],
  "redirects": [
    { "source": "/gi-core-boxes.html", "destination": "/gi-core-boxes", "permanent": true },
    { "source": "/plastic-core-boxes.html", "destination": "/plastic-core-boxes", "permanent": true },
    { "source": "/trunks.html", "destination": "/trunks", "permanent": true },
    { "source": "/clientele.html", "destination": "/clientele", "permanent": true }
  ],
  "rewrites": [
    { "source": "/gi-core-boxes", "destination": "/gi-core-boxes.html" },
    { "source": "/plastic-core-boxes", "destination": "/plastic-core-boxes.html" },
    { "source": "/trunks", "destination": "/trunks.html" },
    { "source": "/clientele", "destination": "/clientele.html" }
  ]
}
