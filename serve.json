{
  "cleanUrls": true,
  "redirects": [
    { "source": "/hello-world", "destination": "/", "type": 301 },
    { "source": "/hello-world/**", "destination": "/", "type": 301 }
  ],
  "rewrites": [
    { "source": "/gi-core-boxes", "destination": "/gi-core-boxes.html" },
    { "source": "/plastic-core-boxes", "destination": "/plastic-core-boxes.html" },
    { "source": "/trunks", "destination": "/trunks.html" },
    { "source": "/clientele", "destination": "/clientele.html" }
  ]
}
